# Nano Banana 图片生成 API
NANO_BANANA_API_KEY=sk-your-api-key-here
NANO_BANANA_API_BASE=https://grsaiapi.com
NANO_BANANA_MODEL=nano-banana-pro

# LLM 模型（用于生成绘本大纲，兼容 OpenAI Chat Completions 接口）
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=sk-your-llm-api-key
LLM_BASE_URL=https://api.deepseek.com/v1

# MinerU 云端 PDF OCR 服务（在 https://mineru.net 申请 API Token）
MINERU_API_KEY=your-mineru-token
MINERU_MODEL_VERSION=vlm

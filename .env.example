# =============================================================================
# AI 绘本生成器 — 环境变量配置
# 复制此文件为 .env，填入你的 API 密钥
# cp .env.example .env
# =============================================================================

# ========================= 图片生成（必填） =========================
# IMAGE_PROVIDER — 选择图片生成服务商
#   可选值：
#     nano-banana  （默认）https://grsaiapi.com  (gpt-image-2)
#     openai-dalle                         (DALL-E 3)
IMAGE_PROVIDER=nano-banana

# IMAGE_API_KEY — 图片生成 API 密钥（必填）
IMAGE_API_KEY=sk-your-key-here

# IMAGE_API_BASE — API 地址（默认 https://grsaiapi.com）
IMAGE_API_BASE=https://grsaiapi.com

# IMAGE_MODEL — 模型名
#   例如：gpt-image-2, dall-e-3, flux-pro 等
IMAGE_MODEL=gpt-image-2

# ========================= 文本生成 / LLM（必填） =========================
# 支持任何 OpenAI Chat Completions 兼容接口
# 热门选项：
#   DeepSeek  →  https://api.deepseek.com/v1       模型: deepseek-v4-flash
#   OpenAI    →  https://api.openai.com/v1          模型: gpt-4o
#   Groq      →  https://api.groq.com/openai/v1     模型: llama-3.1-70b-versatile
#   通义千问  →  https://dashscope.aliyuncs.com/compatible-mode/v1  模型: qwen-plus
#   本地 Ollama → http://localhost:11434/v1          模型: qwen2.5:7b
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-llm-api-key
LLM_MODEL=deepseek-v4-flash

# ========================= PDF OCR（可选） =========================
# 仅在处理扫描版 PDF（图片格式）时需要
# 申请：https://mineru.net
MINERU_API_KEY=your-mineru-token
MINERU_MODEL_VERSION=vlm

# ========================= 其他配置 =========================
# FLASK_DEBUG=0           # 调试模式（1 开启）
# JOB_TTL_HOURS=24        # 任务自动清理时间（小时）
